PORT=8080
TZ=Asia/Jakarta

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=api_ipenpoto
DB_MAX_OPEN_CONNS=45
DB_MAX_IDLE_CONNS=12
DB_CONN_MAX_LIFETIME=300
DB_SSL_MODE=require

# Security - CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Authentication - Rate Limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW=30m
SESSION_MAX=24h

# Email Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=isi_dengan_username_anda
SMTP_PASS=isi_dengan_password_anda
SMTP_SENDER_NAME="CV. Transforma Alam Kreasi"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your_very_secure_jwt_secret_key_min_32_characters_long

# AWS Configuration (Optional)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=your_aws_bucket_name
AWS_USE_PATH_STYLE_ENDPOINT=false
